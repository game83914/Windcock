# 群暉 NAS 自託管環境變數範例（區網優先，公開時換成網域）。
# 用法：複製為 nas.env，填好後在 Container Manager 建專案時匯入，或放在 compose 同目錄改名 .env。
# 正式上線前必換：JWT_SECRET、PROFILE_ENCRYPTION_KEY 系列。

# NAS 區網 IP（公開時改為 https://你的網域）
NAS_IP=192.168.1.100

# API
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://192.168.1.100:3000
PROFILE_ENCRYPTION_KEY=
PROFILE_ENCRYPTION_KEY_VERSION=1
PROFILE_HASH_PEPPER=replace-with-a-random-secret
MEDIA_PUBLIC_BASE_URL=http://192.168.1.100:3001/api/v1
VOTE_REWARD_POINTS=5

# Web（瀏覽器用）；容器間 SSR 走 compose 內建的 API_PROXY_TARGET，無需修改
NUXT_PUBLIC_API_BASE=http://192.168.1.100:3001/api/v1
NUXT_PUBLIC_WS_BASE=http://192.168.1.100:3001

# 產生 32 bytes Base64 金鑰（PROFILE_ENCRYPTION_KEY 用）：
#   openssl rand -base64 32
