DATABASE_URL="postgresql://windcock:windcock@localhost:5432/windcock?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PROFILE_ENCRYPTION_KEY=
PROFILE_ENCRYPTION_KEY_VERSION=1
# 輪替後保留舊金鑰，例如 PROFILE_ENCRYPTION_KEY_V1="old-32-byte-base64-key"
PROFILE_HASH_PEPPER="replace-with-a-random-secret"
PORT=3001

# Development-only virtual identities on the operator account; always disabled in production
DEV_IDENTITY_SWITCHER_ENABLED=true
DEV_IDENTITY_OPERATOR_PHONE=0911111111

# Privacy thresholds. Production enforces floors of 30/10, district 100/20, and stance cohorts 10.
# For one-account UI testing only, set these values to 1 outside production.
DEMOGRAPHIC_MIN_TOTAL=1
DEMOGRAPHIC_MIN_COHORT=1
DEMOGRAPHIC_DISTRICT_MIN_TOTAL=1
DEMOGRAPHIC_DISTRICT_MIN_COHORT=1
STANCE_ANALYTICS_MIN_COHORT=1

# SMS (stub) - leave empty for test mode; OTP is logged/returned in mock mode
SMS_PROVIDER=
SMS_API_KEY=

# Rate limits
REGISTER_MAX_PER_IP_DAY=20
LOGIN_MAX_PER_IP_DAY=100
LOGIN_MAX_PER_ACCT_HOUR=10
OTP_EXPIRE_SECONDS=300
VOTE_REWARD_POINTS=5
MEME_USAGE_ACTOR_DAILY_LIMIT=10
MEME_USAGE_CREATOR_DAILY_LIMIT=50

# Stances
STANCE_MAX_DEPTH=4
STANCE_COMMON_GROUND_MIN=3

# Redis (host/port only; no URL/TLS support)
REDIS_HOST=localhost
REDIS_PORT=6379

# Turnstile
TURNSTILE_SECRET=

# Local GIF media (single API instance with persistent disk)
MEDIA_ROOT=../../.local/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3001/api/v1
AVATAR_MAX_UPLOAD_BYTES=5242880
AVATAR_MAX_WIDTH=4096
AVATAR_MAX_HEIGHT=4096
AVATAR_MAX_PIXELS=16777216
AVATAR_MAX_UPLOADS_PER_HOUR=10
OPTION_IMAGE_MAX_UPLOAD_BYTES=5242880
OPTION_IMAGE_MAX_WIDTH=1024
OPTION_IMAGE_MAX_HEIGHT=1024
OPTION_IMAGE_MAX_PIXELS=16777216
OPTION_IMAGE_MAX_UPLOADS_PER_HOUR=20
GIF_MAX_UPLOAD_BYTES=10485760
GIF_MAX_WIDTH=4096
GIF_MAX_HEIGHT=4096
GIF_MAX_FRAMES=200
GIF_MAX_DURATION_MS=30000
GIF_MAX_TOTAL_PIXELS=100000000
GIF_MAX_UPLOADS_PER_HOUR=5
GIF_MAX_UPLOADS_PER_IP_HOUR=20
MEDIA_QUARANTINE_TTL_MINUTES=60
MEDIA_ORPHAN_GRACE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# AI-assisted topic and stance authoring (server-side only)
AI_AUTHORING_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSE_FORMAT=json_schema
AI_AUTHORING_TIMEOUT_MS=25000
AI_AUTHORING_MAX_OUTPUT_TOKENS=1800
AI_AUTHORING_SESSION_TTL_SECONDS=900
AI_AUTHORING_MAX_GENERATIONS_PER_HOUR=10
AI_AUTHORING_MAX_GENERATIONS_PER_DAY=30
AI_AUTHORING_MAX_GENERATIONS_PER_IP_HOUR=30
AI_AUTHORING_MAX_RESPONSE_BYTES=262144
