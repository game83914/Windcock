generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum UserRole {
  USER
  ADMIN
}

enum MembershipTier {
  NEW
  SENIOR
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationMembershipRole {
  MEMBER
  MANAGER
  OWNER
}

enum OrganizationMembershipStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentRole {
  TOPIC_TEAM
}

enum AssignmentScope {
  GLOBAL
  ORGANIZATION
  TOPIC
}

enum TopicApplicationApplicantType {
  MEMBER
  ORGANIZATION
}

enum TopicApplicationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TopicKind {
